{
  "name": "serverest-cypress",
  "version": "1.0.0",
  "description": "Testes E2E (frontend) e de API do ServeRest com Cypress",
  "scripts": {
    "test": "cypress run",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "test:frontend": "cypress run --spec 'cypress/e2e/frontend/**/*.cy.js'",
    "cy:open": "cypress open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.0.5",
    "globals": "^17.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
